---
import fs from "fs";
import path from "path";
import { exec } from "child_process";

const listaSistemasOpciones = [
  "COMPONENTES", "CONTABILIDAD", "BANCOS", "NOMINAS", "XML EN LINEA",
  "SERVIDOR DE LICENCIAS COMUN", "RESPALDOS", "COMERCIAL PRO", "COMERCIAL PREMIUM", "FACTURA ELECTRONICA"
];

const esProduccion = process.env.NODE_ENV === 'production' || !fs.existsSync('./src');
const folder = esProduccion ? 'data' : 'src/data';
const rutaDatos = path.join(process.cwd(), folder, 'clientes.json');
const rutaConfig = path.join(process.cwd(), folder, 'config.json');

let datosIniciales = [];
try {
  if (fs.existsSync(rutaDatos)) {
    const rawData = fs.readFileSync(rutaDatos, "utf-8");
    datosIniciales = JSON.parse(rawData);
  }
} catch (error) {
  console.error("Error al leer el archivo JSON:", error);
}

let configInicial = { versionesMercado: {}, cartasTecnicas: {} };
try {
  if (fs.existsSync(rutaConfig)) {
    configInicial = JSON.parse(fs.readFileSync(rutaConfig, "utf-8"));
  }
} catch (error) {
  console.error("Error al leer el archivo config:", error);
}
---

<head>
  <meta charset="UTF-8">
  <title>Panel de Control - Versiones de Sistemas</title>
  <style>
    body { font-family: 'Segoe UI', system-ui, sans-serif; margin: 30px; background-color: #d6e7f8 !important; color: #334155; }
    h1 { color: #0f172a; margin-bottom: 5px; font-size: 1.8rem; }
    p.sub { color: #64748b; margin-bottom: 25px; font-size: 0.95rem; }
    .flex-layout { display: grid; grid-template-columns: 310px 1fr; gap: 25px; align-items: start; }
    .panel { border: none; padding: 20px; border-radius: 12px; background: white; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05); margin-bottom: 20px; }
    .market-title { font-size: 1rem; color: #0f172a; margin-top: 0; margin-bottom: 15px; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; }
    .market-grid { display: flex; flex-direction: column; gap: 14px; }
    .market-row { display: flex; flex-direction: column; gap: 4px; background: #f8fafc; padding: 8px; border-radius: 8px; border: 1px solid #e2e8f0; }
    .market-row label { font-size: 0.75rem; font-weight: 700; color: #1e293b; }
    .market-input-group input { padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 5px; font-size: 0.8rem; width: 93%; }
    .main-controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; gap: 15px; flex-wrap: wrap; }
    .search-input { padding: 10px 16px; border: 1px solid #cbd5e1; border-radius: 8px; width: 250px; font-size: 0.9rem; }
    .table-container { overflow-x: auto; overflow-y: auto; max-height: 72vh; background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05); border: 1px solid #e2e8f0; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem; }
    th, td { padding: 12px 14px; border-bottom: 1px solid #f1f5f9; }
    th { position: sticky; top: 0; background-color: #f8fafc; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 0.75rem; z-index: 10; box-shadow: inset 0 -1px 0 #e2e8f0; }
    tr:hover { background-color: #f8fafc; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-bottom: 20px; }
    .form-group { display: flex; flex-direction: column; gap: 4px; }
    .form-group label { font-size: 0.8rem; font-weight: 600; color: #475569; }
    input, textarea, select { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.9rem; color: #334155; }
    button { padding: 8px 16px; cursor: pointer; background: #0284c7; color: white; border: none; border-radius: 6px; font-weight: 600; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s; }
    button:hover { background: #0369a1; }
    .btn-sm { padding: 5px 10px; font-size: 0.75rem; border-radius: 6px; }
    .btn-danger { background: #ef4444; } .btn-danger:hover { background: #dc2626; }
    .btn-success { background: #22c55e; } .btn-success:hover { background: #16a34a; }
    .btn-secondary { background: #64748b; } .btn-secondary:hover { background: #475569; }
    .sys-client-section { border-top: 1px solid #e2e8f0; margin-top: 20px; padding-top: 15px; }
    .sys-client-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
    .contenedor-campos-extras { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-top: 10px; }
    .extra-field-row { display: flex; gap: 8px; align-items: center; }
    .toast-notificacion { position: fixed; bottom: 20px; right: 20px; background-color: #10b981; color: white; padding: 12px 20px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1); z-index: 9999; }
    /* === MODAL DE SELECCIÓN DE CANAL === */
    .modal-canal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; display: flex; align-items: center; justify-content: center; }
    .modal-canal-card { background: white; border-radius: 14px; padding: 26px; width: 360px; max-width: 92vw; box-shadow: 0 20px 50px rgba(0,0,0,0.25); }
    .modal-canal-titulo { font-size: 1.05rem; font-weight: 700; color: #0f172a; margin: 0 0 5px; }
    .modal-canal-sub { font-size: 0.82rem; color: #64748b; margin: 0 0 18px; }
    .modal-canal-btn { width: 100%; display: flex; align-items: center; gap: 12px; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; cursor: pointer; margin-bottom: 9px; font-size: 0.85rem; text-align: left; color: #0f172a; transition: border-color 0.15s, background 0.15s; }
    .modal-canal-btn:hover { border-color: #94a3b8; background: white; }
    .modal-canal-btn-icono { font-size: 1.5rem; flex-shrink: 0; }
    .modal-canal-btn-label { font-weight: 600; color: #0f172a; display: block; }
    .modal-canal-btn-desc { font-size: 0.75rem; color: #64748b; display: block; }
    .modal-canal-cancelar { display: block; text-align: center; font-size: 0.8rem; color: #94a3b8; cursor: pointer; margin-top: 6px; padding: 6px; }
    .modal-canal-cancelar:hover { color: #475569; }
  </style>
</head>

<h1>📊 Control de Versiones de Sistemas</h1>
<p class="sub">Soporte CONTPAQi — CRM Técnico.</p>

<div class="flex-layout">
  <div class="panel">
    <h3 class="market-title">🚀 Versiones Oficiales y Cartas</h3>
    <div class="market-grid">
      {listaSistemasOpciones.map(sistema => (
        <div class="market-row">
          <label>{sistema}</label>
          <div class="market-input-group">
            <input type="text" class="input-version-oficial" data-sistema={sistema} placeholder="Versión oficial actual" style="margin-bottom: 2px;" />
            <input type="text" class="input-carta-tecnica" data-sistema={sistema} placeholder="🔗 Link Carta Técnica" style="font-size: 0.75rem; border-color: #e2e8f0;" />
          </div>
        </div>
      ))}
    </div>
    <button id="btnGuardarVersionesOficiales" class="btn-success btn-sm" style="width: 100%; margin-top: 15px; justify-content: center;">💾 Guardar Todo</button>
    
    <div style="margin-top: 25px; border-top: 2px solid #e2e8f0; padding-top: 15px;">
      <h3 class="market-title">📝 Plantilla de Mensaje</h3>
      <div class="form-group" style="margin-bottom: 10px;">
        <label style="font-size: 0.75rem;">Cuerpo del mensaje (WhatsApp/Mail)</label>
        <textarea id="txtPlantillaCuerpo" rows="8" style="font-size: 0.75rem; width: 93%;" placeholder="Usa [contacto], [empresa] y [sistemas_pendientes] como variables."></textarea>
      </div>
      <button id="btnGuardarPlantilla" class="btn-secondary btn-sm" style="width: 100%; justify-content: center;">💾 Guardar Plantilla</button>
    </div>
  </div>

  <div>
    <div class="main-controls">
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <input type="text" id="txtBuscar" class="search-input" placeholder="🔍 Buscar empresa o contacto...">
        <select id="selectFiltroSistema">
          <option value="">🎯 Todos los Sistemas</option>
          {listaSistemasOpciones.map(sistema => <option value={sistema}>{sistema}</option>)}
        </select>
        <button id="btnFiltroFavoritos" style="background: #f59e0b;"><span id="icono-filtro-fav">☆</span> <span id="texto-filtro-fav">Ver Favoritos</span></button>
      </div>
      
      <div style="display:flex; gap:8px;">
        <button id="btnWspMasivo" class="btn-success" style="background-color: #059669;">📢 WhatsApp (<span class="lblCountSeleccionados">0</span>)</button>
        <button id="btnMailMasivo" style="background-color: #0078d4;">✉️ Correo (<span class="lblCountSeleccionados">0</span>)</button>
        <button id="btnNuevo">➕ Registrar Empresa</button>
      </div>
    </div>

    <form id="formulario" class="panel" onsubmit="event.preventDefault();" style="display:none; border: 1px solid #bae6fd; background-color: #f0f9ff;">
      <h3 id="form-titulo" style="margin-top: 0; color: #0369a1;">Registrar Empresa</h3>
      <input type="hidden" id="edit-index">
      
      <div class="form-grid">
        <div class="form-group"><label>Empresa / Razón Social *</label><input id="form-empresa" required></div>
        <div class="form-group"><label>Contacto Principal</label><input id="form-contacto"></div>
        <div class="form-group"><label>Correo Electrónico</label><input id="form-correo" type="email"></div>
        <div class="form-group"><label>Teléfono 1</label><input id="form-telefono1"></div>
        <div class="form-group"><label>Teléfono 2</label><input id="form-telefono2"></div>
      </div>

      <div style="border-top: 1px dashed #cbd5e1; margin-top:15px; padding-top:10px;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <h4 style="margin:0; font-size:0.85rem; color:#0369a1;">⚙️ Especificaciones Técnicas</h4>
          <button type="button" id="btnAgregarCampoExtra" class="btn-sm btn-secondary">➕ Añadir campo extra</button>
        </div>
        <div id="contenedorCamposExtras" class="contenedor-campos-extras"></div>
      </div>

      <div class="sys-client-section">
        <h4 style="margin-top: 0; margin-bottom: 10px; font-size: 0.9rem; color: #0369a1;">Sistemas Instalados:</h4>
        <div class="sys-client-grid">
          {listaSistemasOpciones.map(sistema => (
            <div class="form-group">
              <label style="color:#0284c7; font-size: 0.75rem;">{sistema}</label>
              <input id={`sys-${sistema.replace(/\s+/g, '_')}`} class="sistema-version-input" data-sistema={sistema} placeholder="No aplica" style="padding: 5px 8px; font-size: 0.8rem;">
